{
    "IDLE": {
        "animation": "idle",
        "fps": 6,

        "behaviour": "STATIONARY",

        "conditional_particles": [
            {"if": ["CLICK"],
             "emit": "dirt"
            }
        ],

        "transitions": [
            {
                "if": ["ANIMATION_END", {"app":"explorer.exe", "is":"focused"}],
                "to": "MAGNIFYING_GLASS",
                "chance": 0.3,
                "transition_animation": "looking_for_something",
                "transition_animation_cfg": {
                    "fps": 6
                }
            },
            {
                "if": [ "ANIMATION_END", {"var":"sleepiness", "op":">", "value":30}],
                "to": "BLINK",
                "chance": 0.3
            },
            {
                "if": ["ANIMATION_END"],
                "to": "BLINK",
                "chance": 0.1
            },
            {
                "if": [ {"pulse":"ANIMATION_END"}],
                "to": "LOOKING_AROUND",
                "chance": 0.03
            },
            {
                "if": [ 
                    {"pulse":"ANIMATION_END"}, 
                    {"var":"sitting_still_timer", "op":">", "value":100}
                ],
                "to": "ROLL",
                "chance": 0.05
            },
            {
                "if": [ 
                    {"pulse":"ANIMATION_END"},
                    {"var":"sitting_still_timer", "op":">", "value":100}
                ],
                "to": "TROLLING",
                "chance": 0.005
            },
            {
                "if": [ 
                    {"pulse":"CLICK"}   
                    ],
                "to": "ROLL"
            },
            {
                "if": [ 
                    {"pulse":"ANIMATION_END"},
                    {"var":"want_tea", "op":">", "value":60}
                ],
                "to": "SIP1",
                "chance": 0.3,
		        "transition_animation": "looking_for_something",
                "transition_animation_cfg": {
                    "fps": 6
                }
            },
            {
                "if": [ 
                    {"pulse":"ANIMATION_END"},
                    {"var":"want_tea", "op":">", "value":200}
                ],
                "to": "SIP2",
                "chance": 0.2,
		        "transition_animation": "looking_for_something",
                "transition_animation_cfg": {
                    "fps": 6
                }
            },
            {
                "if": [ 
                    {"pulse":"ANIMATION_END"},
                    {"var":"want_tea", "op":">", "value":400}
                ],
                "to": "SIP3",
                "chance": 0.2,
		        "transition_animation": "looking_for_something",
                "transition_animation_cfg": {
                    "fps": 6
                }
            }
        ]
    },

    "BLINK": {
        "animation": "blink",

        "transitions": [
            {
                "if": ["DRAGGING_STARTED"],  
                "to": "DRAGGING"
            },
            {
                "if": [{"pulse":"ANIMATION_END"}, {"var":"sleepiness", "op":">", "value":60}],
                "to": "DOZING_OFF",
                "chance": 0.6
            },
            {
                "if": [{"pulse":"ANIMATION_END"}],
                "to": "IDLE"
            }
        ]

    },

    "DOZING_OFF": {
        "animation": "dozing_off",

        "transitions": [
            {
                "if": ["ANIMATION_END", {"var":"sleepiness", "op":">", "value":100}],
                "to": "SLEEPING",
                "transition_animation": "falling_asleep",
                "transition_animation_cfg": {
                    "fps": 8
                },
                "chance": 0.5
            },
            {
                "if": [{"pulse":"ANIMATION_END"}, {"var":"sleepiness", "op":">", "value":60}],
                "to": "DOZED_OFF",
                "chance": 1
            },
            {
                "if": [{"pulse":"ANIMATION_END"}],
                "to": "IDLE",
                "transition_animation": "waking_up",
                "transition_animation_cfg": {
                    "fps": 7
                }
            }
        ]

    },

    "DOZED_OFF": {
        "animation": "dozed_off",

        "constant_particles": [
            {"emit": "sleep_z"}
        ],

        "conditional_particles": [
            {"if": ["CLICK"],
            "emit": "single_z"}
        ],

        "transitions": [
            {
                "if": [{"pulse":"CLICK"}],
                "to": "IDLE",
                "chance": 0.7,
                "transition_animation": "waking_up",
                "transition_animation_cfg": {
                    "fps": 9
                },
                "variables_on_transition": [
                    {"var": "sleepiness", "op": "-=", "value": 5}
                ]
            },
            {
                "if": ["ANIMATION_END", {"var":"sleepiness", "op":">", "value":80}],
                "to": "SLEEPING",
                "transition_animation": "falling_asleep",
                "transition_animation_cfg": {
                    "fps": 8
                },
                "chance": 0.8
            },
            {
                "if": [{"pulse":"ANIMATION_END"}, {"var":"time_spent_in_this_state", "op":">", "value":30} ],
                "to": "IDLE",
                "chance": 0.2,
                "transition_animation": "waking_up",
                "transition_animation_cfg": {
                    "fps": 6
                },
                "variables_on_transition": [
                    {"var": "sleepiness", "op": "=", "value": 0}
                ]
            }
        ]

    },

    "SLEEPING": {
        "animation": "sleeping",

        "constant_particles": [
            {"emit": "sleep_zzz"}
        ],

        "transitions": [
            {
                "if": [ {"pulse":"ANIMATION_END"}, {"var":"time_spent_in_this_state", "op":">", "value":10}],
                "to": "IDLE",
                "chance": 1,
                "transition_animation": "waking_up_after_sleep",
                "variables_on_transition": [
                    {"var": "sleepiness", "op": "=", "value": -300},
                    {"var": "want_tea", "op": "+=", "value": 300}
                ]
            }
        ]
    },

    "LOOKING_AROUND": {
        "animation": "look_around",
        "loop": false,
        "transitions": [
            {
                "if": [ {"pulse":"CLICK"}],
                "to": "ROLL"
            },
            {
                "if": ["DRAGGING_STARTED"],  
                "to": "DRAGGING"
            }
        ],
        "exit_when": ["ANIMATION_END"],
        "exit_to": "IDLE"
    },

    "ROLL": {
        "animation": "roll",
        "behaviour": "MOVE_RANDOM_X_ON_SURFACE",

        "variables_on_enter": [
            {"var": "sitting_still_timer", "op": "=", "value": 0}
        ],
        
        "transitions": [
            {
                "if": [{"flag":"MOVEMENT_FINISHED"}],
                "to": "BLINK",
                "chance": 0.1
            }
        ],
        "exit_when": ["MOVEMENT_FINISHED"],
        "exit_to": "IDLE"
    }, 

    "JUMP": {
        "animation": "roll",
        "behaviour": "JUMP",

        "variables_on_enter": [
            {"var": "sitting_still_timer", "op": "=", "value": 0}
        ],
        
        "transitions": [
            {
                "if": [{"flag":"MOVEMENT_FINISHED"}],
                "to": "BLINK",
                "chance": 0.1
            }
        ],
        "exit_when": ["MOVEMENT_FINISHED"],
        "exit_to": "IDLE"
    },

    "DRAGGING": {
        "animation": "held_by_the_nose",
        "fps": 5,
        "behaviour": "DRAGGING",
        "settings": {
            "gravity": 5000
        },

        "force_transition": [
            {
                "if": ["DRAGGING_STARTED"],
                "except_states": ["DRAGGING"]
            }
        ],
        
        "exit_when": ["DRAGGING_ENDED"],
        "exit_to": "FALLING"
    },

    "FALLING": {
        "animation": "roll",
        "behaviour": "FALL",

        "force_transition": [
            {
                "if": ["LOST_PARENT"],
                "except_states": ["DRAGGING"]
            }
        ],
        
        "transitions": [
            {
                "if": ["MOVEMENT_FINISHED"],
                "to": "IDLE",
                "transition_animation": "standing_up",
                "transition_animation_cfg": {
                    "fps": 12
                },
                "particles_on_transition": [{"emit": "dirt"}]
            }
        ],
        "exit_when": ["MOVEMENT_FINISHED"],
        "exit_to": "IDLE"
    },    

    "VERY_WORRIED": {
        "animation": "grow",
        "times_to_loop": 5,
        "variables_on_enter": [
            {"var": "worrying_meter", "op": "=", "value": 0}
        ],
        "transitions":[
            {
                "if": ["ANIMATION_FINISHED"],
                "to": "IDLE"
            }
        ]
    }, 

    "TROLLING": {
        "animation": "idle",
        "fps": 0,

        "transitions":[
            {
                "if": [ 
                    "CLICK", 
                    {"var": "times_clicked_this_state", "op": ">=", "value": 1}
                    ],
                "to": "IDLE",
                "transition_animation": "trollface",
                "transition_animation_cfg": {
                    "fps": 10
                }
            }
        ]
    },

    "MAGNIFYING_GLASS": {
        "animation": "magnifying_glass",
        "fps": 7,

        "transitions":[
            {
                "if": ["CLICK"],
                "to": "IDLE"
            },
            {
                "if": [ {"var":"time_spent_in_this_state", "op":">", "value":3}],
                "to": "IDLE",
		        "transition_animation": "laying_magnifying_glass_down"
            }
        ]
    },

    "SIP1": {
        "animation": "sip1",

        "transitions":[
            {
                "if": ["ANIMATION_END"],
                "to": "SIP1",
		        "chance": 0.7
            }
        ],

        "variables_on_exit": [
            {"var": "want_tea", "op": "-=", "value": {"randint": [5, 20]}}
        ],

        "exit_when": ["ANIMATION_END"],
        "exit_to": "IDLE",
	    "exit_animation": "after_sip1"
    },

    "SIP2": {
        "animation": "sip2",

        "transitions":[
            {
                "if": ["ANIMATION_END"],
                "to": "SIP2",
		        "chance": 0.5
            }
        ],

        "variables_on_exit": [
            {"var": "want_tea", "op": "-=", "value": 20}
        ],

        "exit_when": ["ANIMATION_END"],
        "exit_to": "IDLE",
	    "exit_animation": "after_sip2"
    },

    "SIP3": {
        "animation": "sip3",

        "transitions":[
            {
                "if": ["ANIMATION_END"],
                "to": "SIP3",
		        "chance": 0.2
            }
        ],

        "variables_on_exit": [
            {"var": "want_tea", "op": "-=", "value": 50}
        ],

        "exit_when": ["ANIMATION_END"],
        "exit_to": "IDLE",
	    "exit_animation": "after_sip3"
    }
 
}
